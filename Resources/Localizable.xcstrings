      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จแล้ว"
          }
        }
      }
    },
    "Drag one slot onto another to swap them. Positions stay fixed so your hand can learn them.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากช่องหนึ่งไปวางบนอีกช่องเพื่อสลับ ตำแหน่งคงที่เพื่อให้มือจำได้"
          }
        }
      }
    },
    "Dragged item": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของที่ลาก"
          }
        }
      }
    },
    "Dropped files are copied here (undoable).": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่ปล่อยจะถูกคัดลอกมาที่นี่ (ย้อนได้)"
          }
        }
      }
    },
    "Dropped files or links open in this app.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์หรือลิงก์ที่ปล่อยจะเปิดในแอปนี้"
          }

{
  "sourceLanguage": "en",
  "strings": {
    "%@ files": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไฟล์"
          }
        }
      }
    },
    "%@ items": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ รายการ"
          }
        }
      }
    },
    "(binary file, %@ — not shown)": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "(ไฟล์ไบนารี %@ — ไม่แสดง)"
          }
        }
      }
    },
    "(large file, %@ — not shown)": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "(ไฟล์ใหญ่ %@ — ไม่แสดง)"
          }
        }
      }
    },
    "1 item": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 รายการ"
          }
        }
      }
    },
    "A bare shake never opens it, because macOS uses that to enlarge the pointer.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สะบัดเปล่า ๆ จะไม่เปิดวง เพราะ macOS ใช้ท่านี้ขยายเคอร์เซอร์ให้หาเจอ"
          }
        }
      }
    },
    "A pack named “%@” is already installed": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งชุดคำสั่งชื่อ “%@” ไว้แล้ว"
          }
        }
      }
    },
    "Action not found": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบคำสั่ง"
          }
